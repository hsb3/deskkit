# --- personalization: the real profile never ships; the example does ---
_knowledge/profile.yaml
_knowledge/profile.json
_knowledge/profile.md
!_knowledge/profile.example.yaml

# --- secrets / env ---
.env
.env.*
!.env.example

# --- Go (librarian/) ---
/librarian/librarian
/librarian/dist/
*.o
*.test

# --- PocketBase runtime store (never committed; the real store lives under $XDG_DATA_HOME) ---
pb_data/

# --- Node / TS (plugin/opencode, plugin/claude-plugin) ---
node_modules/
dist/
build/
*.tsbuildinfo
bun.lockb

# --- OS / editor litter ---
.DS_Store


logs/
# --- _meta/ operations: secrets/live-ops stay local; the empty dir survives a clone (ADR-0006, dotfiles-agents) ---
_meta/operations/*
!_meta/operations/.gitkeep

# --- desk-toolkit bytecode ---
_meta/plans/_utils/__pycache__/

# --- Claude Code (machine-local; per the desk standard: narrow ignores, track deliberate config) ---
.claude/settings.local.json
.claude/worktrees/
.claude/agent-memory/
.claude/*.lock
.claude/**/.DS_Store
