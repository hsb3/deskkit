# --- local dogfooding: this repo is NOT an exec desk. A personal _knowledge/ created here (to
#     drive the tools against the repo) is a local artifact — never tracked, never committable.
#     The shipped example profile lives with the desk-setup scaffold template, not at repo root.
#     (Leading slash anchors this to the repo root; the template's own _knowledge/ stays tracked.) ---
/_knowledge/

# --- secrets / env ---
.env
.env.*
!.env.example

# --- Go (librarian/) ---
/librarian/librarian
/librarian/dist/
*.o
*.test

# --- PocketBase runtime store (never committed; the real store lives under $XDG_DATA_HOME) ---
pb_data/

# --- stray Node/JS artifacts (repo-root web/ ships inside the deskkit binary via go:embed; the
#     scripts/ gates themselves stay dep-free) ---
node_modules/
dist/
build/

# --- SPA embed dir: the bare `dist/` rule above ignores it wholesale, which would also hide
# the tracked .gitkeep that keeps go:embed compiling on a bare checkout — re-include just that ---
!/librarian/internal/core/spa/dist/
/librarian/internal/core/spa/dist/*
!/librarian/internal/core/spa/dist/.gitkeep

# --- OS / editor litter ---
.DS_Store


logs/
# --- _meta/ operations: secrets/live-ops stay local; the empty dir survives a clone (ADR-0006, dotfiles-agents) ---
_meta/operations/*
!_meta/operations/.gitkeep

# --- desk-toolkit bytecode ---
_meta/plans/_utils/__pycache__/

# --- Claude Code (machine-local; per the desk standard: narrow ignores, track deliberate config) ---
.claude/settings.local.json
.claude/worktrees/
**/.claude/agent-memory/
.claude/*.lock
.claude/**/.DS_Store
.claude/handoff.stamp
CLAUDE.local.md

# >>> project-memory (managed) >>>
# narrow-ignore: ignore only machine-local/transient; track everything else under .claude/
# (memory/, rules/, settings.json stay tracked & transferable)
.claude/settings.local.json
.claude/worktrees/
.claude/*.lock
.claude/**/.DS_Store
# <<< project-memory (managed) <<<
