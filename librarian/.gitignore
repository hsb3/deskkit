# PocketBase runtime data (SQLite); created at runtime (spec §2.8).
pb_data/

# Built binary (root-anchored only — a bare "deskkit" would also
# ignore the cmd/deskkit/ source directory). The pre-rename name stays ignored so
# stale binaries in existing checkouts don't show up as untracked noise.
/deskkit
/pocket-librarian

# Local operator-editable ignore boundary is auto-created under DESK_ROOT, not here,
# but guard against a stray copy in the module root.
/.librarian-ignore

# Makefile serve/stop runtime artifacts (old pidfile name kept for pre-rename checkouts).
.deskkit.pid
.pocket-librarian.pid
serve.log

# Local env / secrets — never committed (spec §3.4, §10.1).
.env

# OS litter.
.DS_Store
