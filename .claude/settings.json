{
  "enabledPlugins": {
    "desk-standard@desk-standard": true,
    "code-desk@dotfiles-agents": true,
    "exec-desk@dotfiles-agents": true
  },
  "enabledMcpjsonServers": [
    "desk-standard-dev",
    "desk-persona-dev"
  ],
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(bun install)",
      "Bash(bun test:*)",
      "Bash(bun run:*)",
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(gofmt:*)",
      "Bash(node scripts/:*)",
      "Bash(shellcheck:*)",
      "Bash(actionlint:*)",
      "Bash(deskkit:*)"
    ],
    "ask": [
      "Bash(deskkit apply-fix:*)",
      "Bash(deskkit restore:*)"
    ]
  }
}
